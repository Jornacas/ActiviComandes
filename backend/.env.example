# Puerto del servidor
PORT=3000

# Token de autenticación (mismo que en Apps Script)
AUTH_TOKEN=comanda_materials_2024

# Google Sheets
SPREADSHEET_ID=TU_SPREADSHEET_ID_AQUI

# Credenciales de Google (dejarás el archivo credentials.json en la carpeta backend)
GOOGLE_APPLICATION_CREDENTIALS=./credentials.json

# ActiviHub (Supabase, projecte ActiviShift). Dades mestres: escoles, monitors,
# activitats. NOMÉS servidor — mai amb prefix NEXT_PUBLIC_.
SUPABASE_URL=https://XXXX.supabase.co
SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY_AQUI
# Estats d'activitat visibles. Quan el curs arrenqui i tot passi a ACTIVA, es pot
# deixar només ACTIVA.
ACTIVIHUB_ESTATS=ACTIVA,CONFIRMADA

# Google Chat: compte del Workspace en nom del qual es publiquen les notificacions.
# Requereix delegació de domini per a l'scope chat.messages.create i una app de Chat
# configurada al projecte de Google Cloud. Obligatòria: sense això, no hi ha notificacions.
GOOGLE_CHAT_IMPERSONATE_USER=admin@eixos-creativa.com
